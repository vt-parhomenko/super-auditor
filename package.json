{
  "name": "super-auditor",
  "version": "0.1.0",
  "description": "Локальний аудит виробничої документації на відповідність стандартам замовників",
  "main": "out/main/index.js",
  "type": "commonjs",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "rebuild:electron": "electron-builder install-app-deps",
    "rebuild:node": "npm rebuild better-sqlite3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@tanstack/react-query": "^5.102.8",
    "better-sqlite3": "^13.0.3",
    "mammoth": "^1.12.2",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "parts.aplusauto.superauditor",
    "productName": "Super Auditor",
    "files": ["out/**/*", "resources/icon.ico", "resources/icon.png"],
    "asarUnpack": ["resources/icon.ico", "resources/icon.png"],
    "directories": { "buildResources": "resources" },
    "win": { "icon": "resources/icon.ico" },
    "mac": { "icon": "resources/icon.png" },
    "linux": { "icon": "resources/icon.png" }
  }
}
